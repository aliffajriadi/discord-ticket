# Satu-satunya yang perlu ada di sini. Token bot, Client ID, Client Secret, dan URL
# dashboard diisi lewat halaman web saat pertama kali bot dijalankan (kode setup
# tampil di terminal).
DATABASE_URL="file:./dev.db"

# Opsional
# DASHBOARD_PORT=3000     # port web dashboard (default 3000)
# AUTO_DB_PUSH=0          # matikan sinkronisasi database otomatis saat start
# DASHBOARD_HOST=0.0.0.0   # 127.0.0.1 jika dashboard hanya diakses lewat reverse proxy (Nginx/Caddy)
