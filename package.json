{
  "name": "dc-ticket-bot",
  "version": "2.0.0",
  "type": "module",
  "description": "Discord all-in-one bot: tickets, moderation, lockdown, sticky notes + web dashboard",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "deploy": "tsx src/deploy.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "keywords": [
    "discord",
    "ticket",
    "moderation",
    "bot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "discord.js": "^14.21.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "prisma": "^6.10.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.32",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
